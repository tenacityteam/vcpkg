 # include "global.h"
 
+# include <stdint.h>
 # include <stdlib.h>
 # include <zlib.h>
 
 # include "id3tag.h"
 # include "util.h"
 
+/*
+ * NAME:	util->stralloc()
+ * DESCRIPTION:	allocate room for length elements of the given size plus a
+ *		terminator, failing instead of overflowing the size computation
+ */
+void *id3_util_stralloc(id3_length_t length, size_t size)
+{
+  if (size == 0 || length >= SIZE_MAX / size)
+    return 0;
+
+  return malloc(((size_t) length + 1) * size);
+}
+
